// Crate dependency graph for the upstream DeepSeek-TUI workspace.
// Generated by parsing each crate's Cargo.toml for `path = "..."` dependencies.
// Nodes: 14 workspace member crates.
// Edges: A -> B  means crate A has a path dependency on crate B.
//
// Source: https://github.com/Hmbown/DeepSeek-TUI @ HEAD (shallow clone)

digraph deepseek_tui_crates {
    rankdir=LR;
    node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="Helvetica"];
    edge [color="#666666"];

    // --- Nodes (14 crates) ---
    "deepseek-protocol"   [fillcolor="#e3f2fd"];  // pure types, no deps
    "deepseek-secrets"    [fillcolor="#e3f2fd"];
    "deepseek-state"      [fillcolor="#e3f2fd"];
    "deepseek-mcp"        [fillcolor="#e3f2fd"];
    "deepseek-tui-core"   [fillcolor="#e3f2fd"];

    "deepseek-hooks"      [fillcolor="#fff3e0"];
    "deepseek-execpolicy" [fillcolor="#fff3e0"];
    "deepseek-tools"      [fillcolor="#fff3e0"];
    "deepseek-config"     [fillcolor="#fff3e0"];
    "deepseek-agent"      [fillcolor="#fff3e0"];

    "deepseek-core"       [fillcolor="#e8f5e9"];
    "deepseek-app-server" [fillcolor="#e8f5e9"];
    "deepseek-tui"        [fillcolor="#e8f5e9"];
    "deepseek-cli"        [fillcolor="#ffebee"];  // top-level binary

    // --- Edges (path dependencies) ---
    "deepseek-hooks"       -> "deepseek-protocol";
    "deepseek-execpolicy"  -> "deepseek-protocol";
    "deepseek-tools"       -> "deepseek-protocol";
    "deepseek-config"      -> "deepseek-secrets";

    "deepseek-agent"       -> "deepseek-config";

    "deepseek-core"        -> "deepseek-agent";
    "deepseek-core"        -> "deepseek-config";
    "deepseek-core"        -> "deepseek-execpolicy";
    "deepseek-core"        -> "deepseek-hooks";
    "deepseek-core"        -> "deepseek-mcp";
    "deepseek-core"        -> "deepseek-protocol";
    "deepseek-core"        -> "deepseek-state";
    "deepseek-core"        -> "deepseek-tools";

    "deepseek-app-server"  -> "deepseek-agent";
    "deepseek-app-server"  -> "deepseek-config";
    "deepseek-app-server"  -> "deepseek-core";
    "deepseek-app-server"  -> "deepseek-execpolicy";
    "deepseek-app-server"  -> "deepseek-hooks";
    "deepseek-app-server"  -> "deepseek-mcp";
    "deepseek-app-server"  -> "deepseek-protocol";
    "deepseek-app-server"  -> "deepseek-state";
    "deepseek-app-server"  -> "deepseek-tools";

    "deepseek-tui"         -> "deepseek-secrets";
    "deepseek-tui"         -> "deepseek-tools";

    "deepseek-cli"         -> "deepseek-agent";
    "deepseek-cli"         -> "deepseek-app-server";
    "deepseek-cli"         -> "deepseek-config";
    "deepseek-cli"         -> "deepseek-execpolicy";
    "deepseek-cli"         -> "deepseek-mcp";
    "deepseek-cli"         -> "deepseek-secrets";
    "deepseek-cli"         -> "deepseek-state";

    // Note: deepseek-tui-core has no internal path deps in its Cargo.toml.
    // Note: the workspace declares 14 members; the build plan referenced "16
    // upstream crates" but the actual count at HEAD is 14.
}
